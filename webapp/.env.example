# Environment variables required by the webapp.
# Copy to .env for local development, or set them in the host's dashboard
# (Railway → project → Variables) for a deployment. Never commit real values.

# --- Azure App Registration (Microsoft Graph access to the Excel file) ------
# Azure Portal > Microsoft Entra ID > App registrations > your app.
# Read by graph_client.py via os.environ.get().
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# --- Flask ------------------------------------------------------------------
# Signs the session cookie that carries flash messages. Use a long random
# string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Required in production: without it the app falls back to a key that is
# public in this repo's source.
FLASK_SECRET_KEY=

# Local development only. Leave unset/empty in production — Flask's debugger
# exposes an interactive Python console to anyone who can reach the app.
# Accepts: 1, true, yes, on
FLASK_DEBUG=

# --- Supplied by the host ---------------------------------------------------
# Railway injects PORT automatically; the Procfile binds gunicorn to it.
# Do not set this yourself.
# PORT=
